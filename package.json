{
  "name": "@promptmanager/code-normify",
  "version": "0.8.0",
  "description": "PromptManager 本地架构设计工具：模块树、JSON Schema、接口与可独立验证的分支拆分契约，提供 CRUD、校验、交接包和受管 MCP。",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "import": "./lib/index.js"
    },
    "./service": {
      "types": "./lib/types/service.d.ts",
      "import": "./lib/service.js"
    },
    "./engine/*": {
      "types": "./lib/types/engine/*.d.ts",
      "import": "./lib/engine/*.js"
    }
  },
  "bin": {
    "normify-mcp": "./lib/mcp.js"
  },
  "files": [
    "lib",
    "skills",
    "docs/SPEC.zh-CN.md",
    "README.md",
    "README_EN.md",
    "LICENSE"
  ],
  "license": "MIT",
  "author": "yan-mc",
  "keywords": [
    "promptmanager",
    "mcp",
    "json-schema",
    "worker",
    "architecture",
    "structure-diagram",
    "module-tree",
    "normify"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wishbreeze/code-normify.git"
  },
  "bugs": {
    "url": "https://github.com/wishbreeze/code-normify/issues"
  },
  "homepage": "https://github.com/wishbreeze/code-normify#readme",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "playwright": "^1.62.0",
    "typescript": "^5.9.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "mcp": "node lib/mcp.js",
    "test": "node tests/engine-e2e.mjs && node tests/companion-e2e.mjs && node tests/regression-0.5.2.mjs && node tests/regression-0.5.3.mjs && node tests/regression-0.5.4.mjs && node tests/contracts-e2e.mjs && node tests/graph-e2e.mjs && node tests/change-deletion-e2e.mjs && node tests/branch-e2e.mjs && node tests/mcp-e2e.mjs && node tests/file-ledger-ratchet-e2e.mjs && node tests/reference-graph-e2e.mjs && node tests/change-log-e2e.mjs",
    "test:branches": "node tests/branch-e2e.mjs",
    "test:mcp": "node tests/mcp-e2e.mjs",
    "test:render": "node tests/render-contracts-e2e.mjs",
    "test:ledger-ratchet": "node tests/file-ledger-ratchet-e2e.mjs",
    "test:refgraph": "node tests/reference-graph-e2e.mjs",
    "test:changelog": "node tests/change-log-e2e.mjs",
    "check:refs": "node scripts/check-references.cjs",
    "check:docs": "node scripts/check-doc-snippets.cjs",
    "check:libsync": "node scripts/check-lib-sync.cjs",
    "check:examples": "node scripts/check-examples.cjs",
    "check:ledger": "node scripts/check-file-ledger.cjs",
    "check:ledger:gen": "node scripts/generate-file-ledger.cjs --check",
    "check:graph": "node scripts/generate-reference-graph.cjs --check",
    "check:changes": "node scripts/generate-change-log.cjs --check",
    "ledger:gen": "node scripts/generate-file-ledger.cjs",
    "graph:gen": "node scripts/generate-reference-graph.cjs",
    "changelog:gen": "node scripts/generate-change-log.cjs",
    "check": "npm run typecheck && npm run build && npm test && node ci-contract-check.cjs && npm run check:refs && npm run check:docs && npm run check:libsync && npm run check:examples && npm run check:ledger:gen && npm run check:ledger && npm run check:graph && npm run check:changes"
  }
}
